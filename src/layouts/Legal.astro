---
import Base from './Base.astro';
import { LEGAL_UPDATED_AT } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Base title={title} description={description}>
  <article class="legal">
    <div class="container">
      <h1>{title}</h1>
      <p class="updated">Última atualização: {LEGAL_UPDATED_AT}</p>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .legal {
    padding: var(--space-6) 0;
  }

  .legal .container {
    max-width: 760px;
  }

  h1 {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
  }

  .updated {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin-top: var(--space-2);
  }

  .prose {
    margin-top: var(--space-5);
  }

  .prose :global(h2) {
    font-size: 1.25rem;
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }

  .prose :global(p),
  .prose :global(li) {
    color: #374151;
  }

  .prose :global(p) {
    margin-bottom: var(--space-3);
  }

  .prose :global(ul) {
    margin: 0 0 var(--space-3);
    padding-left: 22px;
  }

  .prose :global(li) {
    margin-bottom: 6px;
  }
</style>
