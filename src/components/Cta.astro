---
import PlayBadge from './PlayBadge.astro';
---

<section class="cta">
  <div class="container inner">
    <h2>Comece a organizar seus aluguéis hoje</h2>
    <p>
      Cadastre o primeiro imóvel em menos de um minuto. Sem conta, sem cartão.
    </p>
    <PlayBadge variant="light" />
  </div>
</section>

<style>
  .cta {
    background: linear-gradient(
      135deg,
      var(--primary-blue) 0%,
      var(--primary-blue-deep) 100%
    );
    color: #fff;
    padding: var(--space-7) 0;
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    max-width: 18ch;
  }

  p {
    color: rgba(255, 255, 255, 0.88);
    font-size: 1.0625rem;
    max-width: 46ch;
    margin-bottom: var(--space-2);
  }
</style>
