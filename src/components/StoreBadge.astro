---
import { APP_STORE_URL, PLAY_STORE_URL } from '../data/site';

interface Props {
  /** Loja de destino do link. */
  store: 'play' | 'apple';
  /** 'light' para fundo claro, 'dark' para fundo escuro/colorido. */
  variant?: 'light' | 'dark';
}

const { store, variant = 'dark' } = Astro.props;

const STORES = {
  play: {
    href: PLAY_STORE_URL,
    small: 'Disponível no',
    big: 'Google Play',
    label: 'Baixar o Aluguel Fácil no Google Play',
  },
  apple: {
    href: APP_STORE_URL,
    small: 'Baixar na',
    big: 'App Store',
    label: 'Baixar o Aluguel Fácil na App Store',
  },
};

const { href, small, big, label } = STORES[store];
---

<a
  class:list={['store-badge', variant]}
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={label}
>
  {
    store === 'play' ? (
      <svg viewBox="0 0 512 512" width="26" height="26" aria-hidden="true">
        {/* As quatro faces partem do mesmo vertice esquerdo e convergem no bico. */}
        <path
          fill="#00D2FF"
          d="M47.6 19.4a25.6 25.6 0 0 0-11.8 21.6v430a25.6 25.6 0 0 0 11.8 21.6l238.2-236.6L47.6 19.4Z"
        />
        <path fill="#00F076" d="M47.6 19.4 344 187.8l-58.2 68.2L47.6 19.4Z" />
        <path
          fill="#FFCE00"
          d="m344 187.8-58.2 68.2L344 324.2l83.4-47.4c18.6-10.6 18.6-31.4 0-42L344 187.8Z"
        />
        <path fill="#FF3A44" d="M47.6 492.6 344 324.2l-58.2-68.2L47.6 492.6Z" />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
        {/* Monocromatico: herda a cor do texto do badge (branco ou escuro). */}
        <path
          fill="currentColor"
          d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
        />
      </svg>
    )
  }
  <span class="labels">
    <span class="small">{small}</span>
    <span class="big">{big}</span>
  </span>
</a>

<style>
  .store-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px 10px 18px;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .store-badge:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .store-badge.dark {
    background: var(--deep-blue);
    color: #fff;
    box-shadow: var(--shadow);
  }

  .store-badge.light {
    background: #fff;
    color: var(--text-primary);
    border-color: var(--border);
    box-shadow: var(--shadow-sm);
  }

  .labels {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-align: left;
  }

  .small {
    font-size: 0.6875rem;
    opacity: 0.75;
    letter-spacing: 0.02em;
  }

  .big {
    font-size: 1.0625rem;
    font-weight: 600;
  }
</style>
