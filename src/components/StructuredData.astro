---
/**
 * Dados estruturados (JSON-LD) lidos por buscadores e assistentes.
 *
 * A home recebe `page="home"` e publica o grafo completo: o app em si
 * (SoftwareApplication), o FAQ e a identidade do site. As demais paginas
 * publicam so a identidade, para nao repetir o mesmo bloco em todo lugar —
 * schema duplicado entre paginas confunde o rastreador.
 */
import {
  SITE,
  SITE_URL,
  APP_SCHEMA,
  PLAY_STORE_URL,
  CONTACT_EMAIL,
  FAQ,
} from '../data/site';

interface Props {
  page?: 'home' | 'inner';
}

const { page = 'inner' } = Astro.props;

const publisher = {
  '@type': 'Organization',
  '@id': `${SITE_URL}/#publisher`,
  name: SITE.name,
  url: SITE_URL,
  logo: `${SITE_URL}/logo.png`,
  email: CONTACT_EMAIL,
  contactPoint: {
    '@type': 'ContactPoint',
    email: CONTACT_EMAIL,
    contactType: 'customer support',
    availableLanguage: ['pt-BR'],
  },
};

const website = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: SITE.name,
  description: SITE.description,
  inLanguage: 'pt-BR',
  publisher: { '@id': `${SITE_URL}/#publisher` },
};

const application = {
  '@type': 'SoftwareApplication',
  '@id': `${SITE_URL}/#app`,
  name: SITE.name,
  description: SITE.description,
  url: SITE_URL,
  downloadUrl: PLAY_STORE_URL,
  installUrl: PLAY_STORE_URL,
  applicationCategory: APP_SCHEMA.category,
  operatingSystem: APP_SCHEMA.operatingSystem,
  inLanguage: 'pt-BR',
  image: `${SITE_URL}${APP_SCHEMA.image}`,
  screenshot: `${SITE_URL}${APP_SCHEMA.image}`,
  publisher: { '@id': `${SITE_URL}/#publisher` },
  // Gratuito para baixar; a assinatura PRO e uma compra dentro do app.
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock',
  },
};

const faqPage = {
  '@type': 'FAQPage',
  '@id': `${SITE_URL}/#faq`,
  mainEntity: FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const graph =
  page === 'home'
    ? [publisher, website, application, faqPage]
    : [publisher, website];

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
/>
