---
import { FEATURES } from '../data/site';

const ICONS: Record<string, string> = {
  dashboard:
    '<rect x="3" y="3" width="7" height="9" rx="2"/><rect x="14" y="3" width="7" height="5" rx="2"/><rect x="14" y="12" width="7" height="9" rx="2"/><rect x="3" y="16" width="7" height="5" rx="2"/>',
  whatsapp:
    '<path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.5L3 21l2-5.7A8.4 8.4 0 1 1 21 11.5Z"/>',
  receipt:
    '<path d="M5 3h14v18l-3-2-2 2-2-2-2 2-2-2-3 2V3Z"/><path d="M9 8h6M9 12h6"/>',
  tax: '<path d="M9 7h6M9 12h6M9 17h3"/><rect x="4" y="3" width="16" height="18" rx="2"/>',
  contract:
    '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5"/>',
  tools:
    '<path d="M14.7 6.3a4 4 0 0 1 5 5l-9.5 9.5a2.1 2.1 0 0 1-3-3l9.5-9.5"/><path d="m7 7-3-3 2-2 3 3"/>',
};
---

<section class="section" id="recursos">
  <div class="container">
    <header class="head">
      <span class="eyebrow">Recursos</span>
      <h2 class="section-title">Feito para o dia a dia de quem aluga</h2>
      <p class="section-subtitle">
        Não é imobiliária, CRM nem ERP. É um painel simples para você cuidar dos
        próprios imóveis com organização e calma.
      </p>
    </header>

    <div class="grid">
      {
        FEATURES.map((feature) => (
          <article class="card">
            <span class="icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={ICONS[feature.icon]}
              />
            </span>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    max-width: 640px;
    margin-bottom: var(--space-6);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .card {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
    transition: box-shadow 0.18s ease, transform 0.18s ease,
      border-color 0.18s ease;
  }

  .card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    border-color: #d7dde5;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--action-soft);
    color: var(--primary-blue);
    margin-bottom: var(--space-3);
  }

  .icon svg {
    width: 22px;
    height: 22px;
  }

  .card h3 {
    font-size: 1.0625rem;
    margin-bottom: 6px;
  }

  .card p {
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
