---
import { PLAY_STORE_URL } from '../data/site';

interface Props {
  /** 'light' para fundo claro, 'dark' para fundo escuro/colorido. */
  variant?: 'light' | 'dark';
}

const { variant = 'dark' } = Astro.props;
---

<a
  class:list={['play-badge', variant]}
  href={PLAY_STORE_URL}
  target="_blank"
  rel="noopener"
  aria-label="Baixar o Aluguel Fácil no Google Play"
>
  <svg viewBox="0 0 512 512" width="26" height="26" aria-hidden="true">
    <!-- As quatro faces partem do mesmo vertice esquerdo e convergem no bico. -->
    <path
      fill="#00D2FF"
      d="M47.6 19.4a25.6 25.6 0 0 0-11.8 21.6v430a25.6 25.6 0 0 0 11.8 21.6l238.2-236.6L47.6 19.4Z"
    />
    <path
      fill="#00F076"
      d="M47.6 19.4 344 187.8l-58.2 68.2L47.6 19.4Z"
    />
    <path
      fill="#FFCE00"
      d="m344 187.8-58.2 68.2L344 324.2l83.4-47.4c18.6-10.6 18.6-31.4 0-42L344 187.8Z"
    />
    <path
      fill="#FF3A44"
      d="M47.6 492.6 344 324.2l-58.2-68.2L47.6 492.6Z"
    />
  </svg>
  <span class="labels">
    <span class="small">Disponível no</span>
    <span class="big">Google Play</span>
  </span>
</a>

<style>
  .play-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px 10px 18px;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .play-badge:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .play-badge.dark {
    background: var(--deep-blue);
    color: #fff;
    box-shadow: var(--shadow);
  }

  .play-badge.light {
    background: #fff;
    color: var(--text-primary);
    border-color: var(--border);
    box-shadow: var(--shadow-sm);
  }

  .labels {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-align: left;
  }

  .small {
    font-size: 0.6875rem;
    opacity: 0.75;
    letter-spacing: 0.02em;
  }

  .big {
    font-size: 1.0625rem;
    font-weight: 600;
  }
</style>
