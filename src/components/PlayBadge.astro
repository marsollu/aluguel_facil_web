---
import { PLAY_STORE_URL } from '../data/site';

interface Props {
  /** 'light' para fundo claro, 'dark' para fundo escuro/colorido. */
  variant?: 'light' | 'dark';
}

const { variant = 'dark' } = Astro.props;
---

<a
  class:list={['play-badge', variant]}
  href={PLAY_STORE_URL}
  target="_blank"
  rel="noopener"
  aria-label="Baixar o Aluguel Fácil no Google Play"
>
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
    <path fill="#EA4335" d="M3.6 1.8a1.5 1.5 0 0 0-.5 1.1v18.2c0 .45.19.85.5 1.1l10-10.2-10-10.2Z" />
    <path fill="#FBBC04" d="m17.4 8.4-3.8-2.2-2.6 2.7 2.6 2.7 3.9-2.2c.7-.4.7-1.4-.1-1.8Z" />
    <path fill="#4285F4" d="M3.6 1.8 13.6 6.2 16 8.6 3.6 1.8Z" />
    <path fill="#34A853" d="M3.6 22.2 16 15.4l-2.4-2.4-10 9.2Z" />
  </svg>
  <span class="labels">
    <span class="small">Disponível no</span>
    <span class="big">Google Play</span>
  </span>
</a>

<style>
  .play-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px 10px 18px;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .play-badge:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .play-badge.dark {
    background: var(--deep-blue);
    color: #fff;
    box-shadow: var(--shadow);
  }

  .play-badge.light {
    background: #fff;
    color: var(--text-primary);
    border-color: var(--border);
    box-shadow: var(--shadow-sm);
  }

  .labels {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-align: left;
  }

  .small {
    font-size: 0.6875rem;
    opacity: 0.75;
    letter-spacing: 0.02em;
  }

  .big {
    font-size: 1.0625rem;
    font-weight: 600;
  }
</style>
